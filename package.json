{
  "name": "fina-desktop",
  "version": "18.6.0",
  "private": true,
  "description": "Fina desktop para Windows, macOS e Linux",
  "workspaces": [
    "apps/electron"
  ],
  "scripts": {
    "build": "npm run build:electron",
    "build:electron": "npm --workspace fina run build",
    "start": "npm run start:electron",
    "start:electron": "npm --workspace fina run start",
    "test": "npm run test:electron",
    "test:electron": "npm --workspace fina run test",
    "typecheck": "npm --workspace fina run typecheck",
    "dist": "npm --workspace fina run dist",
    "dist:linux": "npm --workspace fina run dist:linux",
    "dist:win": "npm --workspace fina run dist:win",
    "generate-icons": "npm --workspace fina run generate-icons"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@12.11.1": true,
    "electron@34.5.8": true,
    "esbuild@0.28.0": true,
    "tesseract.js@7.0.0": true
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
